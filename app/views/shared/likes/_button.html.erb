<% if current_user && already_liked?(likeable) %>
  <%= button_to unlike_likes_path,
    method: :delete,
    params: like_params_for(likeable),
    class: "btn" do %>
      <% render "shared/likes/count", likeable: likeable %>
  <% end %>
<% else %>
  <%= button_to likes_path,
    method: :post,
    params: like_params_for(likeable),
    class: "btn" do %>
      <% render "shared/likes/count", likeable: likeable %>
  <% end %>
<% end %>